{
  "datasets": [
    {
      "name": "ds_live",
      "displayName": "Live vehicles",
      "queryLines": [
        "SELECT route_short_name, mode, latitude, longitude, delay_min\n",
        "FROM live_vehicles\n",
        "WHERE delay_min IS NOT NULL\n"
      ]
    },
    {
      "name": "ds_kpi",
      "displayName": "Now: summary",
      "queryLines": [
        "SELECT date_format(from_utc_timestamp(max(vehicle_ts), 'America/Denver'), 'yyyy-MM-dd HH:mm') AS data_as_of,\n",
        "       count(*) AS vehicles,\n",
        "       round(avg(delay_min), 1) AS avg_delay_min,\n",
        "       round(100 * avg(CAST(delay_min > 5 AS INT)), 1) AS pct_late_5min\n",
        "FROM live_vehicles\n"
      ]
    },
    {
      "name": "ds_worst",
      "displayName": "Worst routes now",
      "queryLines": [
        "SELECT route_short_name AS route, mode, count(*) AS vehicles, round(avg(delay_min), 1) AS avg_delay_min\n",
        "FROM live_vehicles\n",
        "WHERE delay_min IS NOT NULL\n",
        "GROUP BY route_short_name, mode\n",
        "HAVING count(*) >= 2\n",
        "ORDER BY avg_delay_min DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "ds_pva",
      "displayName": "Prediction vs actual (last 2 days, sample)",
      "queryLines": [
        "SELECT p.predictor, p.horizon,\n",
        "       round(p.predicted_delay_s / 60, 2) AS predicted_min,\n",
        "       round(a.delay_s / 60, 2) AS actual_min\n",
        "FROM delay_predictions p\n",
        "JOIN stop_arrivals a\n",
        "  ON p.service_date = a.service_date AND p.trip_id = a.trip_id\n",
        " AND p.target_stop_sequence = a.stop_sequence\n",
        "WHERE a.is_observed\n",
        "  AND p.service_date >= date_sub(current_date(), 2)\n",
        "  AND abs(a.delay_s) < 3600\n",
        "LIMIT 3000\n"
      ]
    },
    {
      "name": "ds_mon_daily",
      "displayName": "Error over time",
      "queryLines": [
        "SELECT service_date, predictor, round(sum(mae_s * n) / sum(n), 1) AS mae_s\n",
        "FROM prediction_monitoring\n",
        "GROUP BY service_date, predictor\n",
        "ORDER BY service_date\n"
      ]
    },
    {
      "name": "ds_mon_horizon",
      "displayName": "Error by horizon",
      "queryLines": [
        "SELECT predictor, concat(CAST(horizon AS STRING), ' stops') AS horizon_label, horizon,\n",
        "       round(sum(mae_s * n) / sum(n), 1) AS mae_s\n",
        "FROM prediction_monitoring\n",
        "GROUP BY predictor, horizon\n",
        "ORDER BY horizon\n"
      ]
    }
  ],
